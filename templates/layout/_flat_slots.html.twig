{# Darstellung der bereits durch Contao gerenderten, flachen Inhalte.
   Innerhalb einer Rolle gilt weiterhin die redaktionelle Sortierung. #}
{% macro render(elements, role) %}
    {% for element in elements %}
        {% if '<!-- eo-slot:' ~ role ~ ' -->' in element %}{{ element|raw }}{% endif %}
    {% endfor %}
{% endmacro %}

{# Neu angelegte Standard-Elemente bleiben sichtbar, auch ohne Layout-Rolle. #}
{% macro unassigned(elements) %}
    {% for element in elements %}
        {% if '<!-- eo-slot:' not in element %}{{ element|raw }}{% endif %}
    {% endfor %}
{% endmacro %}
