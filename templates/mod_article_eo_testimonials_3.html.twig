{% extends '@Contao/mod_article.html.twig' %}
{% import '@Contao/layout/_flat_slots.html.twig' as slots %}

{% block content %}
<div class="shell testimonial-feature testimonial-feature--case">
  {{ slots.render(elements, 'testimonials-testimonial-feature-1-1') }}
  <div class="testimonial-signature">
    {{ slots.render(elements, 'testimonials-testimonial-feature-1-testimonial-signature-1-1') }}
  </div>
  {{ slots.render(elements, 'testimonials-testimonial-feature-1-2') }}
</div>
<div class="shell testimonial-feature testimonial-feature--closing">
  {{ slots.render(elements, 'testimonials-testimonial-feature-2-1') }}
  <div class="testimonial-signature">
    {{ slots.render(elements, 'testimonials-testimonial-feature-2-testimonial-signature-1-1') }}
  </div>
</div>
{{ slots.unassigned(elements) }}
{% endblock %}
