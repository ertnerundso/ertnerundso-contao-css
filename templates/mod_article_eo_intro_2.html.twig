{% extends '@Contao/mod_article.html.twig' %}
{% import '@Contao/layout/_flat_slots.html.twig' as slots %}

{% block content %}
<div id="showreel" class="section intro showreel-section">
  <div class="showreel-stage">
    <div class="shell showreel-lead">
      {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-showreel-lead-1-1') }}
    </div>
    <div class="showreel-frame">
      {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-showreel-frame-1-1') }}
    </div>
    <div class="shell showreel-outro">
      {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-showreel-outro-1-1') }}
    </div>
    {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-1') }}
    <div class="benefits-section">
      <div class="shell benefits-stage">
        <div class="benefits-lead">
          {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-benefits-section-1-benefits-stage-1-benefits-lead-1-1') }}
        </div>
        <div class="benefits-impact">
          {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-benefits-section-1-benefits-stage-1-benefits-impact-1-1') }}
          <div class="benefits-table">
            <div class="benefit-column">
              {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-benefits-section-1-benefits-stage-1-benefits-impact-1-benefits-table-1-benefit-column-1-1') }}
            </div>
            <div class="benefit-column">
              {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-benefits-section-1-benefits-stage-1-benefits-impact-1-benefits-table-1-benefit-column-2-1') }}
            </div>
            <div class="benefit-column">
              {{ slots.render(elements, 'intro-intro-1-showreel-stage-1-benefits-section-1-benefits-stage-1-benefits-impact-1-benefits-table-1-benefit-column-3-1') }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ slots.unassigned(elements) }}
{% endblock %}
