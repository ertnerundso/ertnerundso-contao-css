{% extends '@Contao/mod_article.html.twig' %}
{% import '@Contao/layout/_flat_slots.html.twig' as slots %}

{% block content %}
<div id="anfrage" class="shell contact-grid">
  <div class="contact-column">
    {{ slots.render(elements, 'contact-grid-contact-grid-1-contact-column-1-1') }}
  </div>
  <div class="contact-meta">
    {{ slots.render(elements, 'contact-grid-contact-grid-1-contact-meta-1-1') }}
