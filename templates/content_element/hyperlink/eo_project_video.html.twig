{# Native Hyperlink-Felder: Video-URL, Linktext und optionales Vorschaubild bleiben im CMS editierbar. #}
{% extends '@Contao/content_element/hyperlink.html.twig' %}

{% block content %}
    {% do csp_source('media-src', href) %}
    <video controls playsinline preload="none" aria-label="{{ link_text }}"{% if image %} poster="{{ image.image.imageSrc }}"{% endif %}>
        <source src="{{ href }}" type="video/mp4">
    </video>
    <a class="text-link" href="{{ href }}">{{ link_text }} <span aria-hidden="true">↗</span></a>
{% endblock %}
