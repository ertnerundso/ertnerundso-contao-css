{% extends '@Contao/mod_article.html.twig' %}
{% import '@Contao/layout/_flat_slots.html.twig' as slots %}

{% block content %}
<div class="section process">
  <div class="shell">
    <div class="process-header">
      <div>
        {{ slots.render(elements, 'process-process-1-heading-1-process-header-1-heading-1-1') }}
      </div>
      {{ slots.render(elements, 'process-process-1-heading-1-process-header-1-1') }}
    </div>
    <div class="steps">
      <div class="step">
        {{ slots.render(elements, 'process-process-1-heading-1-steps-1-step-1-1') }}
      </div>
      <div class="step">
        {{ slots.render(elements, 'process-process-1-heading-1-steps-1-step-2-1') }}
      </div>
      <div class="step">
        {{ slots.render(elements, 'process-process-1-heading-1-steps-1-step-3-1') }}
      </div>
    </div>
  </div>
</div>
{{ slots.unassigned(elements) }}
{% endblock %}
