{% extends '@Contao/mod_article.html.twig' %}
{% import '@Contao/layout/_flat_slots.html.twig' as slots %}

{% block content %}
<div id="arbeiten" class="work">
  <div class="work-stage">
    <div class="shell work-heading">
      {{ slots.render(elements, 'work-work-1-work-stage-1-work-heading-1-1') }}
    </div>
    <div class="work-viewport">
      <div class="work-track">
        {{ slots.render(elements, 'work-work-1-work-stage-1-work-viewport-1-work-track-1-1') }}
        <div class="work-outro">
          {{ slots.render(elements, 'work-work-1-work-stage-1-work-viewport-1-work-track-1-work-outro-1-1') }}
        </div>
      </div>
    </div>
    {{ slots.render(elements, 'work-work-1-work-stage-1-1') }}
    <div class="shell work-progress-shell">
      {{ slots.render(elements, 'work-work-1-work-stage-1-work-progress-shell-1-1') }}
    </div>
  </div>
</div>
{{ slots.unassigned(elements) }}
{% endblock %}
